# =============================================================================
#  NEVER put your main Phantom wallet key here.
#  Create a NEW wallet in Phantom (Add account), send it only what you can
#  afford to lose, then export THAT key: Settings -> Export Private Key.
#  .env is gitignored and must stay that way.
# =============================================================================
PRIVATE_KEY=

# Public endpoints work but are slow and rate limited. A paid RPC
# (Helius, Triton, Shyft) is what makes sniping competitive.
RPC_URL=https://api.mainnet-beta.solana.com
# WS_URL defaults to RPC_URL with http swapped for ws.
# WS_URL=

# Endpoints the event stream falls back to. A public RPC can answer HTTP perfectly
# while its WebSocket silently delivers nothing — observed on mainnet, with the bot
# sitting blind and resubscribing ten times before this existed. Comma separated.
RPC_FALLBACK_URLS=https://api.mainnet-beta.solana.com

# Safety: start with true. Set to false only when you actually want to spend SOL.
DRY_RUN=true

# --- position sizing -------------------------------------------------------
BUY_AMOUNT_SOL=0.01
MAX_SOL_PER_TRADE=0.05
DAILY_SPEND_CAP_SOL=0.5
MAX_OPEN_POSITIONS=3
MIN_SOL_RESERVE=0.02

# --- execution -------------------------------------------------------------
SLIPPAGE_BPS=1500
PRIORITY_FEE_MICROLAMPORTS=500000
COMPUTE_UNIT_LIMIT=250000

# --- exit strategy ---------------------------------------------------------
TAKE_PROFIT_PCT=50
STOP_LOSS_PCT=30
TRAILING_STOP_PCT=0
MAX_HOLD_SECONDS=300

# --- filters ---------------------------------------------------------------
REQUIRE_SOCIALS=false
BLOCKED_NAME_PATTERNS=
MAX_CREATOR_LAUNCHES_PER_HOUR=1

# Reject launches where the creator bought more than this share of supply in the launch
# transaction itself — the classic setup for dumping on whoever snipes it. Measured on
# mainnet the median is under 2%, but the worst run past 79%. 0 disables the check.
MAX_DEV_BUY_PCT=5

# --- entry mode -------------------------------------------------------------
# 'snipe' buys at launch and is a latency contest a public RPC cannot win: measured
# on mainnet, the whole upside lives in the first few hundred milliseconds.
# 'momentum' waits instead — the token has to attract real liquidity and repeated
# buyers before it is worth entering. Slower entry, but latency stops mattering.
# 'copy' ignores the token entirely and follows wallets instead: it scores every wallet
# trading the curve by what they have actually realised, then buys what the ones with a
# record buy. Needs a warm-up before any wallet qualifies.
ENTRY_MODE=snipe
MOMENTUM_MIN_LIQUIDITY_SOL=5
MOMENTUM_MIN_BUYS=8
MOMENTUM_MAX_AGE_SECONDS=120
MOMENTUM_MIN_BUY_RATIO=0.6

# --- learning ----------------------------------------------------------------
# Records how tokens whose names share a word have actually performed, and scores new
# candidates by that history. Outcomes are recorded from the very first trade, but
# scoring stays inert until LEARNING_MIN_TRADES, because with dozens of trades and
# hundreds of distinct words almost every word has been seen once — that is noise, not
# a pattern. Keyword scores are shrunk toward the overall average so one lucky trade
# cannot turn its word into a rule.
LEARNING_ENABLED=true
LEARNING_MIN_TRADES=200
# Reject a candidate whose learned score falls below this (in %). The default is low
# enough to block nothing until you have looked at what the bot actually learned.
LEARNING_MIN_SCORE=-100
LEARNING_PATH=data/keyword-memory.json

# --- copy mode ---------------------------------------------------------------
# What a wallet must have shown on the bonding curve before the bot follows its buys.
# Note the blind spot: once a token graduates its trading moves to PumpSwap and is
# invisible here, so wallets that hold through graduation are undercounted.
COPY_MIN_CLOSED=10
COPY_MIN_REALISED_SOL=1
COPY_MIN_WIN_RATE=0.5
WALLET_PATH=data/wallet-stats.json

# How often to re-check open positions if the account stream goes quiet. The stream
# is the fast path; this is the backstop that guarantees a stop-loss is still checked.
EXIT_POLL_MS=2000

# Dry run would otherwise fill at the launch price — the one price a real transaction
# never gets, and the flattery lands hardest on the tokens that actually run. This is
# how long to wait before pricing a simulated entry off the chain. Set 0 to disable.
DRY_RUN_FILL_DELAY_MS=1500

PORT=8787

# --- dashboard access -------------------------------------------------------
# Empty = the dashboard listens on localhost only (safe default, but your phone
# cannot reach it). Set a long random token to expose it on your local network:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# The dashboard has no other login, so this token is the only thing protecting
# the ARM button and your open positions. Minimum 16 characters.
DASHBOARD_TOKEN=
