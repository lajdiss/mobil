[Unit]
Description=pump.fun sniper
After=network-online.target
Wants=network-online.target

# A crashing bot must not leave positions unattended, but one crash-looping on a bad
# config should give up rather than hammer the RPC forever.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=sniper
WorkingDirectory=/opt/sniper/sniper
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sniper/sniper
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
